// Cloudflare Workers static-assets config — the whole game is static files,
// no Worker script needed. `npx wrangler deploy` (Cloudflare's git CI) reads
// this and serves the repo root at the edge.
{
  "name": "castleofthecrimsonmoon",
  "compatibility_date": "2026-09-30",
  "assets": {
    // Repo root = game root (index.html lives here).
    "directory": "./"
  }
}
